{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-declaration-strict-value"
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "/^--/",
        "fill",
        "stroke",
        "z-index",
        "font-size",
        "line-height",
        "/^padding/",
        "/^margin/",
        "/^gap$/",
        "/gap$/",
        "/^border-radius/",
        "transition-duration",
        "animation-duration",
        "box-shadow",
        "background",
        "min-block-size",
        "max-block-size",
        "inline-size"
      ],
      {
        "ignoreValues": [
          "currentColor",
          "transparent",
          "inherit",
          "initial",
          "unset",
          "revert",
          "none",
          "auto",
          "0",
          "1px",
          "100%"
        ],
        "ignoreFunctions": false,
        "disableFix": true,
        "message": "PC-1: use a design token (var(--\u2026)), not a literal"
      }
    ],
    "declaration-no-important": true,
    "selector-max-compound-selectors": 2,
    "selector-max-id": 0,
    "no-descending-specificity": true,
    "custom-property-pattern": "^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "utility",
          "custom-variant",
          "source",
          "reference",
          "apply",
          "variant",
          "config",
          "plugin",
          "slot"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/tokens.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ],
  "ignoreFiles": [
    "**/dist/**",
    "node_modules/**"
  ]
}
